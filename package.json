{
  "name": "network-modifier",
  "version": "1.0.0",
  "description": "A cross-platform debugging proxy that intercepts and mutates HTTP/HTTPS requests and responses (Fiddler / Charles style) with rules, scripts and breakpoints.",
  "main": "src/index.js",
  "bin": {
    "netmod": "bin/netmod.js",
    "network-modifier": "bin/netmod.js"
  },
  "scripts": {
    "start": "node bin/netmod.js start",
    "trust": "node bin/netmod.js trust",
    "test": "node --test test/*.test.js",
    "release:check": "node scripts/release.mjs --check",
    "release:package": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "proxy",
    "debugging-proxy",
    "mitm",
    "http",
    "https",
    "intercept",
    "fiddler",
    "charles",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amal97/Network-Editor.git"
  },
  "homepage": "https://github.com/Amal97/Network-Editor#readme",
  "bugs": {
    "url": "https://github.com/Amal97/Network-Editor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "http-proxy-agent": "^7.0.2",
    "http2-wrapper": "^2.2.1",
    "https-proxy-agent": "^7.0.6",
    "node-forge": "^1.3.1",
    "socks-proxy-agent": "^8.0.5",
    "ws": "^8.21.3"
  },
  "files": [
    "assets",
    "bin",
    "src",
    "public",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
