{
  "name": "network-modifier",
  "version": "1.0.0",
  "description": "A cross-platform debugging proxy that intercepts and mutates HTTP/HTTPS requests and responses (Fiddler / Charles style) with rules, scripts and breakpoints.",
  "main": "src/index.js",
  "bin": {
    "netmod": "bin/netmod.js",
    "network-modifier": "bin/netmod.js"
  },
  "scripts": {
    "start": "node bin/netmod.js start",
    "trust": "node bin/netmod.js trust",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "proxy",
    "debugging-proxy",
    "mitm",
    "http",
    "https",
    "intercept",
    "fiddler",
    "charles",
    "devtools"
  ],
  "license": "MIT",
  "dependencies": {
    "http-proxy-agent": "^9.1.0",
    "http2-wrapper": "^2.2.1",
    "https-proxy-agent": "^9.1.0",
    "node-forge": "^1.3.1",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.21.3"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md"
  ]
}
