{
  "manifest_version": 3,
  "name": "Network Modifier",
  "version": "1.0.0",
  "description": "Monitor and modify frontend XHR and Fetch requests without a proxy or certificate.",
  "permissions": ["storage", "tabs", "debugger", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Network Modifier", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
